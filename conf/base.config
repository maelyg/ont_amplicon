process {

  cpus = 1
  memory = 1.GB
  time =  1.h 

  withLabel: setting_1 {
    cpus = 1
    memory = 8.GB
  }
  withLabel: setting_2 {
    cpus = 2
    memory = 8.GB
    time = { 5.h }
  }
  withLabel: setting_3 {
    cpus = 2
    memory = 12.GB
    time = { 3.h }
  }
  withLabel: setting_4 {
    cpus = 2
    memory = 12.GB
    time = { 5.h }
  }
  withLabel: setting_5 {
    cpus = 2
    memory = { 24.GB }
  } 
  withLabel: setting_6 {
    cpus = 1
    memory = { 48.GB }
  }
  withLabel: setting_10 {
    cpus = 2
    memory = { 24.GB }
    time = { 3.h }
  }
  errorStrategy = 'retry'
    maxRetries = 2
    maxErrors = 2
}
